def idioma():
    lang = os.environ.get("ROMPELO_LANG")
    if not lang:
        try:
            lang = leer_json(OBS_CONF).get("idioma")
        except Exception:
            lang = None
    return "en" if str(lang or "").lower().startswith("en") else "es"


def _(plantilla, **kw):
    """Traduce la plantilla si el idioma es inglés y rellena los campos. Una plantilla sin entrada en EN
    sale en español: la batería comprueba que el bloqueo inglés no lleva restos."""
    t = EN.get(plantilla, plantilla) if idioma() == "en" else plantilla
    return t.format(**kw) if kw else t
ROMPELO_HOME = os.environ.get("ROMPELO_HOME") or os.path.join(os.path.expanduser("~"), "rompelo")
REGISTRO = os.path.join(ROMPELO_HOME, "checks", "registry.json")
REGISTRO_LOCAL = os.path.join(ROMPELO_HOME, "checks", "registry.local.json")
ALLOWLIST = os.path.join(ROMPELO_HOME, "config", "repos.json")
PRUEBAS_POR_DEFECTO = ["tests/**", "test/**", "**/*.test.*", "**/*.spec.*", "**/*_test.*"]
ID_OK = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
EXCL = [".", ":(exclude).rompelo"]


# ── git ─────────────────────────────────────────────────────────────────────
def git(root, *args):
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)


def raiz_repo(cwd):
    r = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return os.path.realpath(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def head(root):
    r = git(root, "rev-parse", "HEAD")
    return r.stdout.strip() if r.returncode == 0 else "sin-head"


def ref_base(root, base):
    if base and git(root, "cat-file", "-e", f"{base}^{{commit}}").returncode == 0:
        return str(base)
    return "HEAD"


def huella_arbol(root, base=None):
    """Huella del CONTENIDO del árbol sin `.rompelo/`: para cada ruta que difiere de la base
    (rastreada o no), su hash de contenido, o D si se borró. No depende de HEAD ni de si el
    fichero está en el índice: commitear el mismo contenido no cambia la huella."""
    h = hashlib.sha256()
    for p in ficheros_cambiados(root, base):
        f = os.path.join(root, p)
        if os.path.isfile(f):
            h.update(f"{p}:{git(root, 'hash-object', '--', p).stdout.strip()}\n".encode())
        else:
            h.update(f"{p}:D\n".encode())
    return h.hexdigest()[:16]


def ficheros_cambiados(root, base):
    out = set()
    if head(root) != "sin-head":
        out |= {p for p in git(root, "diff", "--name-only", ref_base(root, base), "--", *EXCL).stdout.split("\n") if p}
    out |= {p for p in git(root, "ls-files", "--others", "--exclude-standard", "--", *EXCL).stdout.split("\n") if p}
    return sorted(out)


# ── configuración de confianza (fuera del repo) ─────────────────────────────
def leer_json(f):
    with open(f) as fh:
        return json.load(fh)


def registro(root=None):
    """registry.json (versionado, checks genéricos) + registry.local.json (sin versionar,
    checks de tus repos). Los locales ganan si repiten un id. Si ROMPELO_HOME no tiene ningún
    registro (un runner de CI), vale `.rompelo/registry.json` del propio repo: ahí el repo es la
    fuente de confianza, porque sus cambios pasan por revisión."""
    fuentes = [REGISTRO, REGISTRO_LOCAL]
    if root and not any(os.path.exists(f) for f in fuentes):
        fuentes = [os.path.join(root, ".rompelo", "registry.json")]
    r = {}
    for f in fuentes:
        try:
            parte = leer_json(f)
        except FileNotFoundError:
            continue
        if not isinstance(parte, dict):
            raise ValueError(f"{f} tiene que ser un objeto id → {{argv, cwd}}")
        r.update(parte)
    return {k: v for k, v in r.items() if not k.startswith("_")}


def repos_permitidos():
    try:
        d = leer_json(ALLOWLIST)
        return [os.path.realpath(p) for p in d.get("repos", [])]
    except FileNotFoundError:
        return []


def permitir_repo(root):
    os.makedirs(os.path.dirname(ALLOWLIST), exist_ok=True)
    d = {"repos": []}
    try:
        d = leer_json(ALLOWLIST)
    except FileNotFoundError:
        pass
    if root not in d.setdefault("repos", []):
        d["repos"].append(root)
        with open(ALLOWLIST, "w") as fh:
            json.dump(d, fh, indent=2, ensure_ascii=False)
            fh.write("\n")


def resolver_check(cid, root):
    """Devuelve (argv, cwd) de un id del registro. Nunca ejecuta texto del contrato."""
    if not isinstance(cid, str) or not ID_OK.match(cid):
        raise ValueError(f"id de check inválido (no se ejecuta): {cid!r}")
    reg = registro(root)
    if cid not in reg:
        raise ValueError(f"check desconocido, no está en {REGISTRO} (no se ejecuta): {cid}")
    e = reg[cid]
    argv, cwd = resolver_argv(e, cid, root)
    if not isinstance(e.get("triestado", False), bool):
        raise ValueError(f"registro: {cid}.triestado tiene que ser booleano")
    if type(e.get("min_lineas", 0)) is not int or e.get("min_lineas", 0) < 0:
        raise ValueError(f"registro: {cid}.min_lineas tiene que ser un entero no negativo")
    if "control_positivo" in e:
        resolver_argv(e["control_positivo"], cid + ".control_positivo", root)
    return argv, cwd


def resolver_argv(e, nombre, root):
    if not isinstance(e, dict):
        raise ValueError(f"registro: {nombre} tiene que ser un objeto")
    argv = e.get("argv")
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        raise ValueError(f"registro: {nombre}.argv tiene que ser una lista de cadenas")
    if e.get("cwd", "repo") not in ("repo", "rompelo"):
        raise ValueError(f"registro: {nombre}.cwd tiene que ser repo o rompelo")
    cwd = root if e.get("cwd", "repo") == "repo" else ROMPELO_HOME
    return argv, cwd


def hash_check(e):
    """Vincula la evidencia al instrumento y sus reglas, no a su descripción editorial."""
    d = {k: e.get(k, v) for k, v in (("argv", None), ("cwd", "repo"),
         ("min_lineas", 0), ("triestado", False), ("control_positivo", None))}
    return hashlib.sha256(json.dumps(d, sort_keys=True).encode()).hexdigest()[:16]


def hash_registro(root, c):
    reg = registro(root)
    d = {cid: hash_check(reg[cid]) if cid in reg else None for cid, _ in checks_exigidos(root, c)}
    return hashlib.sha256(json.dumps(d, sort_keys=True).encode()).hexdigest()[:16]


# ── contrato ────────────────────────────────────────────────────────────────
OBLIGATORIAS = ["id", "estado", "scope_paths", "checks", "toca_junta"]


def rutas(root):
    d = os.path.join(root, ".rompelo")
    return d, os.path.join(d, "task.json")


def ruta_limpia(p):
    return isinstance(p, str) and p and not p.startswith("/") and ".." not in p.split("/") and "\x00" not in p


def leer_contrato(root):
    _, f = rutas(root)
    c = leer_json(f)
    if not isinstance(c, dict):
        raise ValueError("task.json tiene que ser un objeto")
    faltan = [k for k in OBLIGATORIAS if k not in c]
    if faltan:
        raise ValueError(f"task.json sin claves obligatorias: {faltan}")
    if not isinstance(c["scope_paths"], list) or not all(ruta_limpia(p) for p in c["scope_paths"]):
        raise ValueError("scope_paths: lista de rutas relativas, sin '..' ni absolutas")
    if not isinstance(c["checks"], list) or not all(isinstance(x, str) and ID_OK.match(x) for x in c["checks"]):
        raise ValueError("checks: lista de ids [a-z0-9._-] del registro; los comandos no van en el contrato")
    if not isinstance(c["toca_junta"], bool):
        raise ValueError("toca_junta tiene que ser true/false")
    n3 = c.get("checks_nivel3", [])
    if not isinstance(n3, list) or not all(isinstance(x, str) and ID_OK.match(x) for x in n3):
        raise ValueError("checks_nivel3: lista de ids del registro; se exigen solo cuando el repo está a nivel 3 (permiso)")
    if not isinstance(c.get("hallazgos", []), list):
        raise ValueError("hallazgos tiene que ser una lista")
    return c


def checks_exigidos(root, c):
    """[(id, es_nivel3)]: los del contrato siempre; los de `checks_nivel3` solo si el observador ha
    subido el repo a nivel 3 con permiso (docs/observacion.md §5)."""
    out = [(cid, False) for cid in c["checks"]]
    if int(estado_repo(root).get("nivel", 0) or 0) >= 3:
        out += [(cid, True) for cid in (c.get("checks_nivel3") or []) if cid not in c["checks"]]
    return out


def hash_contrato(c):
    """Huella del contrato sin `estado`: si cambian checks, scope, junta, hallazgos o
    afirmaciones después del cierre, el cierre deja de valer (hallazgo de Codex, 05-09-2026)."""
    d = {k: v for k, v in c.items() if k != "estado"}
    return hashlib.sha256(json.dumps(d, sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:16]


def dir_evidencia(root, c):
    base = os.path.join(root, ".rompelo", "evidence")
    d = os.path.join(base, re.sub(r"[^A-Za-z0-9._-]", "_", str(c["id"])))
    os.makedirs(d, exist_ok=True)
    gi = os.path.join(base, ".gitignore")  # la evidencia se autoignora; el .gitignore del repo no se toca
    if not os.path.exists(gi):
        with open(gi, "w") as fh:
            fh.write("*\n")
    return d


def leer_evidencia(d, nombre):
    try:
        return leer_json(os.path.join(d, nombre))
    except (FileNotFoundError, ValueError):
        return None


def escribir_evidencia(d, nombre, datos):
    with open(os.path.join(d, nombre), "w") as fh:
        json.dump(datos, fh, indent=2, ensure_ascii=False)
        fh.write("\n")


def ahora():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def casa(path, patron):
    patron = patron.rstrip("/")
    if any(ch in patron for ch in "*?["):
        return fnmatch.fnmatch(path, patron) or fnmatch.fnmatch(path, patron.replace("**/", ""))
    return path == patron or path.startswith(patron + "/")


# ── veredicto ───────────────────────────────────────────────────────────────
def motivos_bloqueo(root, para_cerrar=False, ci=None):
    """ci: {"evidencias": {id: evidencia recién producida}, "estricto": bool, "advertencias": []}.
    En CI no se cree ninguna evidencia guardada (la pudo escribir el agente): los checks se
    ejecutan de nuevo allí. El cruce real no se puede reproducir en CI: queda como advertencia,
    o como bloqueo con --estricto."""
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    hu = huella_arbol(root, c.get("base"))
    m = []
    junta_por_perfil = False
    # La observación (§5 de docs/observacion.md) puede haber subido el nivel del repo. A nivel 2
    # el perfil manda sobre lo que el agente escribió en el contrato.
    obs = estado_repo(root)
    if obs.get("nivel", 0) >= 2:
        perfiles = set(obs.get("perfiles") or [])
        if "junta" in perfiles and not c["toca_junta"]:
            c = dict(c, toca_junta=True)
            junta_por_perfil = True
        if "exterior" in perfiles and not c.get("toca_exterior"):
            c = dict(c, toca_exterior=True)
        if not str(c.get("segunda_pasada") or "").strip():
            m.append(_("observación: nivel {nivel} ({patrones}). Hace falta una segunda pasada explícita antes de cerrar: campo `segunda_pasada` en el contrato con qué se revisó y qué se encontró (aunque sea nada)",
                       nivel=int(obs.get("nivel", 0) or 0), patrones=", ".join(sorted(obs.get("patrones") or [])) or _("por permiso, sin patrones")))

    if str(c["estado"]) == "cerrada" and not ci:
        cerr = leer_evidencia(ev, "cerrada.json")
        cierre_vigente = (cerr and cerr.get("huella") == hu and cerr.get("contrato") == hash_contrato(c)
                          and cerr.get("registro") == hash_registro(root, c))
        # Un cierre no borra un check que se volvió a ejecutar y ahora falla.
        if not cierre_vigente and not para_cerrar:
            if cerr and cerr.get("huella") == hu and cerr.get("contrato") == hash_contrato(c):
                m.append(_("estado: cerrada, pero cambió en el registro la definición de un check. Vuelve a `rompelo check` y `rompelo close`."))
            elif cerr and cerr.get("huella") == hu:
                m.append(_("estado: cerrada, pero el contrato cambió después del cierre. Vuelve a `rompelo check` y `rompelo close`."))
            else:
                m.append(_("estado: cerrada, pero hay cambios posteriores al cierre (huella distinta). Vuelve a `rompelo check` y `rompelo close`."))

    cambiados = ficheros_cambiados(root, c.get("base"))
    fuera = [p for p in cambiados if not any(casa(p, s) for s in c["scope_paths"])]
    if fuera:
        m.append(_("fuera de scope_paths: {lista}", lista=", ".join(fuera[:8]) + (" …" if len(fuera) > 8 else "")))

    reg = registro(root)
    for cid, n3 in checks_exigidos(root, c):
        pre = _("nivel 3: ") if n3 else ""
        if cid not in reg:
            m.append(pre + _("check `{cid}` no está en el registro ({reg}); no se ejecuta ni cuenta", cid=cid, reg=REGISTRO))
            continue
        resolver_check(cid, root)  # también rechaza un control malformado antes de creer evidencia
        e = ci["evidencias"].get(cid) if ci else leer_evidencia(ev, f"check-{cid}.json")
        if ci and e and e.get("saltado"):
            continue
        if e is None:
            m.append(pre + _("check `{cid}` sin ejecutar (usa `rompelo check`)", cid=cid))
        elif e.get("definicion") != hash_check(reg[cid]):
            m.append(pre + _("check `{cid}` cambió en el registro después de ejecutarse", cid=cid))
        else:
            motivo = motivo_check(cid, reg[cid], e)
            if motivo:
                m.append(pre + motivo)
            elif e.get("huella") != hu:
                m.append(pre + _("check `{cid}` se ejecutó sobre otro árbol (hay cambios posteriores)", cid=cid))

    if c["toca_junta"] and ci:
        txt = _("toca_junta: true. El cruce real no se puede reproducir en CI; hay que hacerlo fuera y quedar registrado con `rompelo cruce`.")
        (m if ci.get("estricto") else ci["advertencias"]).append(txt)
    elif c["toca_junta"]:
        cr = leer_evidencia(ev, "cruce.json")
        mc = []
        if cr is None:
            mc.append(_("toca_junta: true y no hay cruce real registrado (`rompelo cruce --nota '…' -- <comando real>`)"))
        elif cr.get("codigo") != 0:
            mc.append(_("el cruce real FALLÓ con código {codigo}: {argv}", codigo=cr.get("codigo"), argv=cr.get("argv")))
        elif cr.get("huella") != hu:
            mc.append(_("el cruce real es anterior al último cambio; hay que cruzar DESPUÉS de desplegar el último cambio"))
        if mc and junta_por_perfil:
            m.append(_("observación: la tarea tocó rutas de junta (perfil `junta`), así que hace falta cruce real aunque el contrato diga toca_junta: false"))
        m += mc

    for h in c.get("hallazgos") or []:
        if not isinstance(h, dict) or not str(h.get("disposicion") or "").strip():
            m.append(_("hallazgo sin disposición: {h}", h=h.get("id") if isinstance(h, dict) else h))

    # Afirmaciones materiales sobre el mundo exterior (criterio de rootml-de, 04-09-2026):
    # cada una lleva estado. verificado = fuente de primera mano + cita textual que zanja;
    # derivado = de qué afirmación verificada; no_verificado = qué falta. Sin estado no existe.
    afs = c.get("afirmaciones") or []
    if c.get("toca_exterior") and not afs:
        m.append(_("toca_exterior: true y no hay ninguna afirmación con estado (verificado | derivado | no_verificado)"))
    for i, a in enumerate(afs, 1):
        et = a.get("estado") if isinstance(a, dict) else None
        tx = (a.get("texto") if isinstance(a, dict) else str(a)) or f"#{i}"
        if et == "verificado":
            if not (str(a.get("fuente") or "").strip() and str(a.get("cita") or "").strip()):
                m.append(_("afirmación «{tx}» marcada verificado sin fuente de primera mano o sin cita textual", tx=tx))
        elif et == "derivado":
            if not str(a.get("de") or "").strip():
                m.append(_("afirmación «{tx}» marcada derivado sin decir de qué se deduce", tx=tx))
        elif et == "no_verificado":
            if not str(a.get("falta") or "").strip():
                m.append(_("afirmación «{tx}» marcada no_verificado sin decir qué falta", tx=tx))
        else:
            m.append(_("afirmación «{tx}» sin estado válido (verificado | derivado | no_verificado)", tx=tx))

    if c.get("exige_prueba_en_diff"):
        globs = c.get("pruebas_glob") or PRUEBAS_POR_DEFECTO
        prueba = [p for p in cambiados if any(casa(p, g) for g in globs)]
        if [p for p in cambiados if p not in prueba] and not prueba:
            m.append(_("el diff cambia código y ninguna prueba (exige_prueba_en_diff). Verde no es cubierto."))
    return m


# ── ejecución sin shell ─────────────────────────────────────────────────────
def ejecutar(argv, cwd):
    t0 = datetime.datetime.now()
    try:
        r = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
        codigo, salida = r.returncode, (r.stdout or "") + (r.stderr or "")
    except OSError as exc:
        codigo, salida = 127, str(exc)
    dur = (datetime.datetime.now() - t0).total_seconds()
    # No se guarda la salida (podría llevar secretos): solo tamaño y hash.
    return {"argv": argv, "cwd": cwd, "codigo": codigo, "segundos": round(dur, 1),
            "lineas_salida": salida.count("\n"),
            "sha_salida": hashlib.sha256(salida.encode()).hexdigest()[:12], "fecha": ahora()}, salida


def ejecutar_check(cid, root):
    """El control prueba el mismo instrumento ANTES del caso real. Solo 1 autoriza seguir."""
    argv, cwd = resolver_check(cid, root)
    reg = registro(root)[cid]
    cp = None
    if "control_positivo" in reg:
        cp, _salida = ejecutar(*resolver_argv(reg["control_positivo"], cid + ".control_positivo", root))
    if cp is not None and cp["codigo"] != 1:
        e = {"argv": argv, "cwd": cwd, "codigo": None, "segundos": 0,
             "lineas_salida": 0, "fecha": ahora(),
             "instrumento": {0: "ciego", 2: "no_pudo_mirar"}.get(cp["codigo"], "abortado")}
    else:
        e, _salida = ejecutar(argv, cwd)
        if cp is not None:
            e["instrumento"] = "operativo"
    if cp is not None:
        e["control_positivo"] = cp
    e.update(id=cid, definicion=hash_check(reg))
    return e


def motivo_check(cid, reg, e):
    if "control_positivo" in reg:
        codigo = (e.get("control_positivo") or {}).get("codigo")
        if codigo == 0:
            return _("check `{cid}`: su control positivo no detectó el caso malo; el verde no vale", cid=cid)
        if codigo == 2:
            return _("check `{cid}`: control positivo NO PUDO MIRAR (instrumento, no hallazgo)", cid=cid)
        if codigo != 1:
            return _("check `{cid}`: control positivo abortó por una ruta no prevista (código {codigo})", cid=cid, codigo=codigo)
    codigo = e.get("codigo")
    if reg.get("triestado") and codigo == 2:
        return _("check `{cid}` NO PUDO MIRAR (instrumento, no hallazgo; código 2)", cid=cid)
    if reg.get("triestado") and codigo not in (0, 1):
        return _("check `{cid}` abortó por una ruta no prevista (código {codigo})", cid=cid, codigo=codigo)
    if codigo != 0:
        return _("check `{cid}` FALLÓ con código {codigo}", cid=cid, codigo=codigo)
    if e.get("lineas_salida", 0) < reg.get("min_lineas", 0):
        return _("check `{cid}` salió con 0 pero sin la salida mínima ({lineas} < {min} líneas): «limpio» no se distingue de «no miré»", cid=cid, lineas=e.get("lineas_salida"), min=reg["min_lineas"])
    return None


def resumen_check(reg, e):
    codigo = e["codigo"] if e["codigo"] is not None else "sin ejecutar"
    partes = [f"código {codigo} en {e['segundos']} s"]
    if "min_lineas" in reg:
        partes.append(f"{e['lineas_salida']}/{reg['min_lineas']} líneas")
    if "control_positivo" in reg:
        partes.append(f"control positivo: código {e['control_positivo']['codigo']} ({e['instrumento']})")
    return ", ".join(partes)


# ── subcomandos ─────────────────────────────────────────────────────────────
def valor(args, k):
    return args[args.index(k) + 1] if k in args and args.index(k) + 1 < len(args) else None


def valores(args, k):
    return [args[i + 1] for i, a in enumerate(args) if a == k and i + 1 < len(args)]


def detectar_checks(root):
    """Checks que el repo ya trae, leídos de sus ficheros, no adivinados. Devuelve
    {id: {argv, cwd, min_lineas, descripcion}} con ids `<repo>.<nombre>`."""
    nombre = re.sub(r"[^a-z0-9._-]", "-", os.path.basename(root).lower()) or "repo"
    out = {}
    pj = os.path.join(root, "package.json")
    if os.path.exists(pj):
        try:
            scripts = (leer_json(pj).get("scripts") or {})
        except (ValueError, OSError):
            scripts = {}
        gestor = "pnpm" if os.path.exists(os.path.join(root, "pnpm-lock.yaml")) else \
                 "yarn" if os.path.exists(os.path.join(root, "yarn.lock")) else \
                 "bun" if os.path.exists(os.path.join(root, "bun.lockb")) else "npm"
        for sc in ("test", "typecheck", "lint", "build", "check"):
            if sc in scripts:
                argv = [gestor, sc] if sc in ("test",) and gestor != "npm" else [gestor, "run", sc]
                if gestor == "npm" and sc == "test":
                    argv = ["npm", "test"]
                out[f"{nombre}.{sc}"] = {"argv": argv, "cwd": "repo", "min_lineas": 1,
                                        "descripcion": f"package.json scripts.{sc}: {scripts[sc][:60]}"}
    if os.path.exists(os.path.join(root, "pyproject.toml")) or os.path.exists(os.path.join(root, "pytest.ini")) \
            or os.path.isdir(os.path.join(root, "tests")) and any(f.startswith("test_") for f in os.listdir(os.path.join(root, "tests"))):
        if not any(k.endswith(".test") for k in out):
            out[f"{nombre}.pytest"] = {"argv": ["python3", "-m", "pytest", "-q"], "cwd": "repo", "min_lineas": 1,
                                       "descripcion": "pytest (pyproject.toml / pytest.ini / tests/test_*)"}
    if os.path.exists(os.path.join(root, "Cargo.toml")):
        out[f"{nombre}.cargo-test"] = {"argv": ["cargo", "test"], "cwd": "repo", "min_lineas": 1, "descripcion": "Cargo.toml"}
    if os.path.exists(os.path.join(root, "go.mod")):
        out[f"{nombre}.go-test"] = {"argv": ["go", "test", "./..."], "cwd": "repo", "min_lineas": 1, "descripcion": "go.mod"}
    mk = os.path.join(root, "Makefile")
    if os.path.exists(mk):
        try:
            objetivos = set(re.findall(r"^([A-Za-z0-9_-]+):", open(mk, encoding="utf-8", errors="replace").read(), re.M))
        except OSError:
            objetivos = set()
        for t in ("test", "check", "lint"):
            if t in objetivos and not any(k.endswith("." + t) for k in out):
                out[f"{nombre}.make-{t}"] = {"argv": ["make", t], "cwd": "repo", "min_lineas": 1, "descripcion": f"Makefile: {t}"}
    return out


def registrar_local(nuevos):
    """Añade al registry.local.json los ids que no existan. Devuelve los añadidos."""
    os.makedirs(os.path.dirname(REGISTRO_LOCAL), exist_ok=True)
    actual = {}
    try:
        actual = leer_json(REGISTRO_LOCAL)
    except FileNotFoundError:
        pass
    anadidos = [k for k in nuevos if k not in actual]
    for k in anadidos:
        actual[k] = nuevos[k]
    if anadidos:
        with open(REGISTRO_LOCAL, "w") as fh:
            json.dump(actual, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
    return anadidos


def cmd_init(root, args):
    d, f = rutas(root)
    if os.path.exists(f) and "--force" not in args:
        sys.exit(f"ya existe {f} (usa --force para sobrescribir)")
    os.makedirs(d, exist_ok=True)
    checks = valores(args, "--check")
    if not checks and "--sin-detectar" not in args:
        detectados = detectar_checks(root)
        if detectados:
            nuevos = registrar_local(detectados)
            checks = sorted(detectados)
            print("checks detectados en el repo (registrados en " + REGISTRO_LOCAL + "):")
            for k in checks:
                print(f"  {k}: {' '.join(detectados[k]['argv'])}" + ("" if k in nuevos else "  (ya estaba)"))
        else:
            print("no he detectado ningún check en el repo (package.json, pyproject, Cargo.toml, go.mod, Makefile). Añade los tuyos con --check <id> y el registro.")
    reg = registro(root)
    desconocidos = [x for x in checks if x not in reg]
    if desconocidos:
        sys.exit(f"checks que no están en el registro {REGISTRO}: {desconocidos}. Añádelos ahí primero (argv, no cadena).")
    c = {
        "schema": 1,
        "id": valor(args, "--id") or "TAREA-" + datetime.date.today().isoformat(),
        "estado": "abierta",
        "base": head(root),
        "descripcion": valor(args, "--desc") or "",
        "scope_paths": valores(args, "--scope") or ["**"],
        "checks": checks,
        "toca_junta": "--junta" in args,
        "exige_prueba_en_diff": "--prueba" in args,
        "hallazgos": [],
        "_ayuda": "hallazgos: [{id, texto, disposicion: confirmado|rechazado|aceptado, nota}]. Lo concede código, no el modelo.",
    }
    with open(f, "w") as fh:
        json.dump(c, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    dir_evidencia(root, c)  # crea .rompelo/evidence/.gitignore
    permitir_repo(root)
    print(f"contrato creado: {f}\nrepo alistado en {ALLOWLIST}")


def cmd_check(root, args):
    # Solo se admite `--id ID` (repetible). Cualquier otro argumento es un error: antes se
    # descartaba en silencio y `rompelo check no.existe` ejecutaba todo y decía «todos en verde»
    # (verde ambiguo: la salida decía «hice lo que pediste» habiendo hecho otra cosa).
    pedidos = valores(args, "--id")
    sobrantes = [a for i, a in enumerate(args) if a != "--id" and not (i > 0 and args[i - 1] == "--id")]
    if sobrantes or ("--id" in args and not pedidos):
        sys.exit(f"rompelo check: argumento(s) no reconocido(s): {' '.join(sobrantes) or '--id sin valor'}\n"
                 "uso: rompelo check [--id ID]...   (sin --id ejecuta todos los checks exigidos por el contrato)")
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    if not c["checks"]:
        print("el contrato no tiene checks")
        return 0
    fallos = 0
    exigidos = checks_exigidos(root, c)
    if pedidos:
        conocidos = {cid for cid, _n3 in exigidos}
        desconocidos = [p for p in pedidos if p not in conocidos]
        if desconocidos:  # no se llama «fuera»: el control positivo muta la única línea `if fuera:` del scope
            sys.exit(f"rompelo check: {', '.join(desconocidos)} no está entre los checks exigidos por el contrato "
                     f"({', '.join(sorted(conocidos)) or 'ninguno'})")
        exigidos = [(cid, n3) for cid, n3 in exigidos if cid in pedidos]
    for i, (cid, n3) in enumerate(exigidos, 1):
        argv, cwd = resolver_check(cid, root)
        print(f"[{i}/{len(exigidos)}] {cid}{' (nivel 3)' if n3 else ''}: {' '.join(argv)}")
        hu = huella_arbol(root, c.get("base"))
        e = ejecutar_check(cid, root)
        e["huella"] = hu
        escribir_evidencia(ev, f"check-{cid}.json", e)
        reg = registro(root)[cid]
        motivo = motivo_check(cid, reg, e)
        if motivo:
            fallos += 1
            print("    " + motivo)
        print("    → " + resumen_check(reg, e))
    print("todos en verde" if not fallos else f"{fallos} check(s) en rojo")
    return 1 if fallos else 0


def cmd_cruce(root, args):
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    if "--id" in args:
        argv, cwd = resolver_check(valor(args, "--id"), root)
    elif "--" in args and args[args.index("--") + 1:]:
        argv, cwd = args[args.index("--") + 1:], root
    else:
        sys.exit("uso: rompelo cruce [--nota TXT] (--id <check del registro> | -- <argv del comando real>)")
    e, salida = ejecutar(argv, cwd)
    e["nota"] = valor(args, "--nota") or ""
    e["huella"] = huella_arbol(root, c.get("base"))
    escribir_evidencia(ev, "cruce.json", e)
    print(("cruce OK" if e["codigo"] == 0 else f"cruce FALLÓ (código {e['codigo']})") + ": " + " ".join(argv))
    if e["codigo"] != 0:
        print("".join(salida.splitlines(True)[-15:]), end="")
    return 0 if e["codigo"] == 0 else 1


def cmd_verify(root, args):
    ci = None
    if "--ci" in args:
        c = leer_contrato(root)
        ci = {"evidencias": {}, "estricto": "--estricto" in args, "advertencias": []}
        hu = huella_arbol(root, c.get("base"))
        for cid, _n3 in checks_exigidos(root, c):
            try:
                argv, cwd = resolver_check(cid, root)
            except ValueError:
                continue  # lo reporta motivos_bloqueo como «no está en el registro»
            if registro(root).get(cid, {}).get("solo_local"):
                ci["evidencias"][cid] = {"saltado": True}
                ci["advertencias"].append(f"check `{cid}` es solo_local: no se ejecuta en CI (necesita algo de la máquina de quien lo cruza)")
                continue
            e = ejecutar_check(cid, root)
            e["huella"] = hu
            ci["evidencias"][cid] = e
            if "--json" not in args:
                print(f"[ci] {cid}: " + resumen_check(registro(root)[cid], e))
    m = motivos_bloqueo(root, ci=ci)
    if ci and ci["advertencias"] and "--json" not in args:
        for a in ci["advertencias"]:
            print("ADVERTENCIA: " + a)
    if ci and "--json" in args:
        print(json.dumps({"ok": not m, "motivos": m, "advertencias": ci["advertencias"]}, ensure_ascii=False))
        return 0 if not m else 1
    if "--json" in args:
        print(json.dumps({"ok": not m, "motivos": m}, ensure_ascii=False))
    elif m:
        print("BLOQUEADO:")
        for x in m:
            print("  - " + x)
    else:
        print("OK: la tarea puede cerrarse")
    return 0 if not m else 1


def cmd_close(root, args):
    m = motivos_bloqueo(root, para_cerrar=True)
    if m:
        print("no se puede cerrar:")
        for x in m:
            print("  - " + x)
        return 1
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    hu = huella_arbol(root, c.get("base"))
    escribir_evidencia(ev, "cerrada.json", {"huella": hu, "contrato": hash_contrato(c),
                                          "registro": hash_registro(root, c), "fecha": ahora()})
    _, f = rutas(root)
    c["estado"] = "cerrada"
    with open(f, "w") as fh:
        json.dump(c, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    informe = informe_llano(root, c, ev)
    with open(os.path.join(ev, "INFORME.md"), "w") as fh:
        fh.write(informe)
    print(informe)
    print(f"tarea {c['id']} cerrada sobre la huella {hu} · informe en {os.path.join(ev, 'INFORME.md')}")
    return 0


def informe_llano(root, c, ev):
    """Tres bloques para quien no lee código: qué se comprobó, qué no se pudo comprobar,
    qué queda a su cargo. Solo hechos que están en la evidencia."""
    reg = registro(root)
    comprobado, no_pudo, a_cargo = [], [], []
    for cid, n3 in checks_exigidos(root, c):
        e = leer_evidencia(ev, f"check-{cid}.json") or {}
        nota = " (solo en esta máquina; CI no lo repite)" if reg.get(cid, {}).get("solo_local") else ""
        if n3:
            nota += " (check de nivel 3, exigido por permiso)"
        comprobado.append(f"{cid}: código {e.get('codigo')} en {e.get('segundos')} s, {e.get('lineas_salida')} líneas de salida{nota}")
        cp = e.get("control_positivo")
        if cp:
            comprobado.append(f"{cid}: control positivo vio el caso malo (código {cp['codigo']}, {cp['lineas_salida']} líneas)")
        else:
            no_pudo.append(f"{cid}: sin control positivo registrado; no se registró una ejecución separada del caso malo")
    if c["toca_junta"]:
        cr = leer_evidencia(ev, "cruce.json") or {}
        comprobado.append("cruce real de la junta: " + " ".join(cr.get("argv") or []) + (f" · {cr.get('nota')}" if cr.get("nota") else ""))
    for a in c.get("afirmaciones") or []:
        if not isinstance(a, dict):
            continue
        if a.get("estado") == "verificado":
            comprobado.append(f"afirmación verificada: {a.get('texto')} (fuente: {a.get('fuente')})")
        elif a.get("estado") == "derivado":
            comprobado.append(f"afirmación derivada: {a.get('texto')} (de: {a.get('de')})")
        elif a.get("estado") == "no_verificado":
            no_pudo.append(f"{a.get('texto')}: falta {a.get('falta')}")
    for h in c.get("hallazgos") or []:
        if isinstance(h, dict) and h.get("disposicion") == "aceptado":
            a_cargo.append(f"hallazgo {h.get('id')} aceptado sin corregir: {h.get('texto') or ''} {('(' + str(h.get('nota')) + ')') if h.get('nota') else ''}".strip())
    if not comprobado:
        comprobado.append("nada: el contrato no tenía checks ni junta")
    lineas = [f"# Informe de cierre · {c['id']}", "", "## Qué se comprobó", ""]
    lineas += ["- " + x for x in comprobado]
    lineas += ["", "## Qué no se pudo comprobar", ""]
    lineas += ["- " + x for x in no_pudo] or ["- nada declarado como no verificado"]
    lineas += ["", "## Qué queda a tu cargo", ""]
    lineas += ["- " + x for x in a_cargo] or ["- nada: no hay hallazgos aceptados sin corregir"]
    # §8 de docs/observacion.md: lo que vio el observador durante la tarea, con sus permisos.
    est = estado_repo(root)
    obs = [f"nivel {est.get('nivel', 0)}"]
    if est.get("perfiles"):
        obs.append("perfiles de riesgo tocados: " + ", ".join(est["perfiles"]))
    if est.get("patrones"):
        obs.append("patrones vistos: " + ", ".join(est["patrones"]))
    for patron, entradas in (leer_json_o(PERMISOS, {}) or {}).items():
        for p in entradas:
            if isinstance(p, dict) and p.get("repo") == root:
                obs.append(f"permiso pedido por `{patron}`: {'sí' if p.get('respuesta') == 'si' else 'no'} ({p.get('fecha', '')[:10]}{', recordado' if p.get('recordar') else ''})")
    if est.get("bajado"):
        obs.append(f"nivel bajado a mano el {str(est['bajado'].get('fecha', ''))[:10]}: {est['bajado'].get('motivo', '')}")
    lineas += ["", "## Qué observó el observador", ""]
    lineas += ["- " + x for x in obs]
    lineas += ["", "Un verde aquí significa «no encontré los de mi clase», no «está bien». Un control positivo solo acredita el caso malo que ejercita.", ""]
    return "\n".join(lineas)


def cmd_status(root, args):
    c = leer_contrato(root)
    est = estado_repo(root)
    print(f"tarea {c['id']} · estado {c['estado']} · huella {huella_arbol(root, c.get('base'))} · nivel {est.get('nivel', 0)} {est.get('perfiles', [])} {est.get('patrones', [])}")
    print(f"scope: {c['scope_paths']}  checks: {c['checks']}")
    print(f"cambiados: {ficheros_cambiados(root, c.get('base'))}")
    return cmd_verify(root, args)


# ── observación (docs/observacion.md) ────────────────────────────────────────
ESTADO = os.path.join(ROMPELO_HOME, "state")
OBS_CONF = os.path.join(ROMPELO_HOME, "config", "observacion.json")
RIESGO_CONF = os.path.join(ROMPELO_HOME, "config", "riesgo.json")
PERMISOS = os.path.join(ROMPELO_HOME, "config", "permisos.json")
UMBRALES = {"firma_repetida": 2, "check_en_rojo": 2, "ediciones_sin_verde": 4, "verde_ambiguo": 2}
RIESGO = {
    "auth":       [r"\b(auth|session|login|logout|token|oauth|jwt|passkey)\b"],
    "secretos":   [r"\.env\b", r"\bsecrets?\b", r"\bvault\b", r"\bpass show\b", r"\bcredentials?\b"],
    "datos":      [r"migrations?/", r"\.sql$", r"\bpsql\b", r"\bsupabase\b", r"prisma migrate", r"\balembic\b"],
    "despliegue": [r"\bdeploy", r"\bwrangler\b", r"docker compose up", r"\bsystemctl\b", r"kubectl apply", r"terraform apply"],
    "junta":      [r"functions/api/", r"\bwebhooks?\b", r"\bn8n\b", r"\bworkflows?/", r"process\.env", r"os\.environ", r"import\.meta\.env"],
    "exterior":   [r"^pnpm (add|install)\b", r"^npm (i|install|add)\b", r"^yarn add\b", r"^pip3? install\b", r"^cargo add\b", r"^go get\b", r"package\.json$", r"pyproject\.toml$", r"requirements.*\.txt$"],
}
# Un «check verde» es un comando que existe para juzgar el código (D2 reinicia el contador de ediciones con él).
CHECKS_VERDES = [
    r"\b(pnpm|npm|yarn|bun)(\s+run)?\s+(test|check|typecheck|lint|build|verify|e2e|smoke|humo|comprobar)\b",
    r"\bpytest\b", r"\bpython3?\s+-m\s+pytest\b", r"\bcargo\s+(test|check|clippy)\b", r"\bgo\s+(test|vet)\b",
    r"\bmake\s+(test|check|lint)\b", r"\brompelo\s+(check|verify)\b",
    r"\b(vitest|jest|tsc|eslint|ruff|mypy|playwright test|astro check)\b", r"scripts?/comprobar-", r"\btests?/[^\s]+\.(sh|py)\b",
]
# Programas cuyo silencio significa «no encontré nada» (D2 verde ambiguo). Un `git add` callado es normal.
BUSCADORES = {"grep", "rg", "ag", "ack", "find", "fd", "git grep", "git diff", "git log", "curl", "wget", "diff", "ls", "jq", "dig", "nslookup", "host", "ss", "netstat", "lsof", "ps", "test"}
# Programas que solo leen: buscar la palabra «token» no es tocar auth (D1). Con redirección, -i, tee o xargs dejan de contar como lectura.
LECTURAS = {"grep", "rg", "ag", "cat", "ls", "find", "fd", "head", "tail", "wc", "stat", "file", "diff", "jq", "less", "tree", "du", "df",
            "which", "type", "echo", "printf", "git log", "git diff", "git status", "git show", "git grep", "git branch", "git rev-parse", "shasum", "md5", "sort", "uniq", "cut", "column"}
# Ficheros cuya edición repetida no pide un check verde (D2 ediciones sin verde): documentación e imágenes.
SIN_CHECK = (".md", ".mdx", ".txt", ".rst", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".pdf", ".ico")


def es_check(cmd):
    return bool(cmd) and any(re.search(pat, cmd) for pat in CHECKS_VERDES)


def solo_lee(evento):
    txt = evento.get("riesgo_texto") or ""
    if evento.get("ficheros"):
        return False
    if re.search(r"(^|\s)>{1,2}\s*\S|\btee\b|\bxargs\b|\bsed\s+-[a-zA-Z]*i|\bperl\s+-[a-zA-Z]*i", txt):
        return False
    return evento.get("prog") in LECTURAS


def leer_json_o(f, defecto):
    try:
        return leer_json(f)
    except (FileNotFoundError, ValueError):
        return defecto


def umbrales():
    u = dict(UMBRALES)
    u.update({k: int(v) for k, v in leer_json_o(OBS_CONF, {}).items() if k in UMBRALES})
    return u


# D1 sube el nivel al SEGUNDO toque de escritura al mismo perfil, no al primero (decisión de José, 05-09-2026,
# tras el control negativo real: `auth` y `secretos` saltaban en todas las sesiones). `exterior` a un toque:
# una dependencia se añade en un solo comando y es D3, no D1.
TOQUES_PERFIL = {"_defecto": 2, "exterior": 1}


def toques_perfil(perfil):
    t = dict(TOQUES_PERFIL)
    conf = leer_json_o(OBS_CONF, {}).get("toques_perfil")
    if isinstance(conf, dict):
        t.update({k: int(v) for k, v in conf.items() if isinstance(v, int)})
    return int(t.get(perfil, t.get("_defecto", 2)))


RIESGO_LOCAL = os.path.join(ROMPELO_HOME, "config", "riesgo.local.json")  # sin versionar: rutas de esta máquina


def perfiles_riesgo(root=None):
    """Perfiles = código ← config/riesgo.json ← config/riesgo.local.json. En cualquiera de los dos, la clave
    `por_repo` {ruta: {perfil: [patrones]}} cambia o apaga (lista vacía) un perfil para ese repo: un repo de
    documentación no tiene `auth` aunque hable de ella todo el día (control negativo real, 05-09)."""
    r = {k: list(v) for k, v in RIESGO.items()}
    por_repo = {}
    for f in (RIESGO_CONF, RIESGO_LOCAL):
        conf = leer_json_o(f, {})
        for k, v in conf.items():
            if isinstance(v, list):
                r[k] = [str(x) for x in v]
        if isinstance(conf.get("por_repo"), dict):
            for ruta, perfiles in conf["por_repo"].items():
                if isinstance(perfiles, dict):
                    por_repo.setdefault(os.path.realpath(os.path.expanduser(ruta)), {}).update(perfiles)
    if root and os.path.realpath(root) in por_repo:
        for k, v in por_repo[os.path.realpath(root)].items():
            if isinstance(v, list):
                r[k] = [str(x) for x in v]
    return r


def ruta_estado_repo(root):
    os.makedirs(os.path.join(ESTADO, "repos"), exist_ok=True)
    return os.path.join(ESTADO, "repos", hashlib.sha256(root.encode()).hexdigest()[:16] + ".json")


def estado_repo(root):
    return leer_json_o(ruta_estado_repo(root), {})


def guardar_estado_repo(root, d):
    with open(ruta_estado_repo(root), "w") as fh:
        json.dump(d, fh, indent=2, ensure_ascii=False)


def normalizar_firma(texto):
    t = texto.strip().lower()
    t = re.sub(r"0x[0-9a-f]+|\b[0-9a-f]{7,}\b", "#", t)
    t = re.sub(r"/[^\s'\"]+", "/…/", t)
    t = re.sub(r"\d+", "#", t)
    t = re.sub(r"[\"'`]", "", t)
    t = re.sub(r"\s+", " ", t)
    return t


def firma_error(stderr, prog, codigo):
    lineas = [l for l in (stderr or "").split("\n") if l.strip()]
    if lineas:
        return hashlib.sha256(normalizar_firma(lineas[-1]).encode()).hexdigest()[:12]
    if codigo not in (None, 0):
        return hashlib.sha256(f"{prog}:{codigo}".encode()).hexdigest()[:12]
    return None


def programa(cmd):
    partes = [p for p in cmd.strip().split() if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", p)]
    if not partes:
        return ""
    prog = os.path.basename(partes[0])
    if prog in ("cd", "pushd"):
        # «cd repo && pnpm test» es pnpm test, no cd (control negativo real, 05-09)
        resto = re.split(r"\s*(?:&&|;|\|\|)\s*", cmd.strip(), 1)
        if len(resto) == 2 and resto[1].strip():
            return programa(resto[1])
    if prog in ("sudo", "env", "time", "nice"):
        return programa(" ".join(partes[1:]))
    if len(partes) > 1 and not partes[1].startswith("-") and prog in (
            "git", "pnpm", "npm", "yarn", "bun", "docker", "cargo", "go", "make", "python3", "python", "node", "bash", "sh", "rompelo", "gh", "kubectl", "terraform", "wrangler", "pip", "pip3"):
        return f"{prog} {os.path.basename(partes[1])}"
    return prog


RUIDO_STDERR = (r"^Shell cwd was reset to ",)  # avisos del harness, no del comando


def limpiar_stderr(texto):
    return "\n".join(l for l in (texto or "").split("\n") if not any(re.match(pat, l) for pat in RUIDO_STDERR))


PARECE_ERROR = re.compile(r"\b(error|fail(?:ed|ure|s)?|traceback|exception|no such file|not found|denied|fatal|panic|cannot|command not found|abort(?:ed)?)\b", re.I)


def parece_error(texto):
    """Sin código de salida (Codex), la última línea del texto decide si hay firma. Es heurística: acierta con
    «No such file», «Error:», «FAILED», y falla con un test runner que solo imprime «12 passed, 1 skipped»."""
    lineas = [l for l in (texto or "").split("\n") if l.strip()]
    return bool(lineas) and bool(PARECE_ERROR.search(lineas[-1]))


def codigo_de_texto(texto):
    """Código de salida SOLO de la primera línea y SOLO con la forma que emiten los agentes
    («Exit code N», doc oficial de Claude Code para PostToolUseFailure.error). Nunca del cuerpo:
    un documento que dice «Exit code 1» o un curl que imprime «exit code: 200» no son códigos (INC-0032)."""
    mo = re.match(r"\s*(?:Error:\s*)?Exit code:?\s*(\d+)\s*$", (texto or "").split("\n", 1)[0])
    return int(mo.group(1)) if mo else None


def evento_desde_hook(ent):
    """Traduce el PostToolUse / PostToolUseFailure de Claude Code o Codex a la línea del libro. Sin
    texto de comandos ni de salidas: solo programa, hash, código, recuentos, firma y rutas.

    Claude Code (doc oficial, leída 05-09-2026): PostToolUse «fires after a tool has already executed
    successfully»; un comando con salida != 0 llega por PostToolUseFailure con `error` = "Exit code N\n…"
    (INC-0031). Codex: PostToolUse «also runs after commands that exit with a non-zero status»; la forma
    de tool_response para Bash NO está verificada, se aceptan campos de código y la primera línea."""
    evento = str(ent.get("hook_event_name") or "PostToolUse")
    tool = str(ent.get("tool_name") or "")
    ti = ent.get("tool_input") or {}
    if not isinstance(ti, dict):
        ti = {}
    es_shell = tool in ("Bash", "bash", "shell")
    cmd = str(ti.get("command") or "") if es_shell else ""
    stdout, stderr, codigo = "", "", None
    sin_codigo = False  # el agente no manda código de salida (Codex): la firma sale del texto, por heurística
    fallo = evento == "PostToolUseFailure"
    if fallo:
        err = ent.get("error") if isinstance(ent.get("error"), str) else ""
        codigo = codigo_de_texto(err)
        # tras la línea de código viene la salida con stdout y stderr entrelazados: vale como stderr para la firma
        stderr = err.split("\n", 1)[1] if (codigo is not None and "\n" in err) else ("" if codigo is not None else err)
    else:
        resp = ent.get("tool_response")
        if isinstance(resp, str) and resp.lstrip().startswith("{"):
            # Codex manda la salida de Bash como CADENA JSON {"output": …, "metadata": {"exit_code": N, …}}
            # (medido con `codex exec` el 05-09-2026, INC-2026-0036). Se abre y se trata como dict.
            try:
                abierto = json.loads(resp)
                if isinstance(abierto, dict):
                    resp = abierto
            except ValueError:
                pass
        if isinstance(resp, dict):
            for k in ("stdout", "output", "content"):
                if isinstance(resp.get(k), str):
                    stdout += resp[k]
            stderr = resp.get("stderr") if isinstance(resp.get("stderr"), str) else ""
            meta = resp.get("metadata") if isinstance(resp.get("metadata"), dict) else {}
            for k in ("exit_code", "exitCode", "code", "returncode"):
                if isinstance(resp.get(k), int):
                    codigo = resp[k]
                    break
                if isinstance(meta.get(k), int):
                    codigo = meta[k]
                    break
            if codigo is None:
                codigo = codigo_de_texto(stderr)
            if codigo is None and es_shell:
                codigo = 0  # PostToolUse solo llega tras éxito (Claude Code); el texto de stdout no cuenta
        elif isinstance(resp, str):
            # Codex (medido con `codex exec`, 05-09-2026): tool_response de Bash es SOLO el texto que el modelo
            # imprimió (`text(r.output)`), sin código de salida. Se deja desconocido (None), no 0: un «ls» roto
            # llegaba como verde y el observador estaba ciego a los fallos en Codex (INC-2026-0036).
            codigo = codigo_de_texto(resp)
            stdout = resp.split("\n", 1)[1] if (codigo is not None and "\n" in resp) else resp
            if codigo is None and es_shell:
                sin_codigo = True
    stderr = limpiar_stderr(stderr)
    ficheros = []
    for k in ("file_path", "path", "notebook_path"):
        if isinstance(ti.get(k), str):
            ficheros.append(ti[k])
    if tool == "apply_patch" or (cmd.startswith("apply_patch") or "*** Begin Patch" in cmd):
        ficheros += re.findall(r"\*\*\* (?:Add|Update|Delete) File: (.+)", cmd)
    prog = programa(cmd) if cmd else tool.lower()
    if not cmd:
        firma = None
    elif codigo not in (None, 0):
        firma = firma_error(stderr, prog, codigo)
    elif fallo:
        firma = hashlib.sha256(f"{prog}:fallo-sin-codigo".encode()).hexdigest()[:12]  # interrupción o el shell no arrancó
    elif sin_codigo and parece_error(stdout):
        firma = firma_error(stdout, prog, None)  # heurística sobre la última línea; documentada en docs/observacion.md §12.3
    else:
        firma = None  # un comando que salió bien no tiene firma de error, diga lo que diga stderr
    return {
        "t": ahora(), "tool": tool, "evento": evento, "prog": prog,
        "cmd_sha": hashlib.sha256(cmd.encode()).hexdigest()[:12] if cmd else None,
        "cmd_es_check": es_check(cmd),
        "codigo": codigo, "stderr_lineas": stderr.count("\n") + (1 if stderr.strip() else 0),
        "stdout_vacio": not (stdout or "").strip(),
        "firma": firma,
        "ficheros": ficheros,
        # Para D1 se mira el comando SIN los cuerpos de heredoc: ahí va texto, no órdenes, y un
        # documento que habla de functions/api no es tocar functions/api (falso positivo en vivo, 05-09).
        "riesgo_texto": (re.sub(r"<<-?\s*['\"]?(\w+)['\"]?.*?^\s*\1\s*$", "", cmd, flags=re.S | re.M) + "\n" + "\n".join(ficheros)),
    }


def perfiles_de(evento):
    txt = evento.get("riesgo_texto") or ""
    hits = set()
    if solo_lee(evento):
        return hits
    for perfil, patrones in perfiles_riesgo(evento.get("repo")).items():
        for pat in patrones:
            try:
                if re.search(pat, txt, re.M | re.I):
                    hits.add(perfil)
                    break
            except re.error:
                continue
    return hits


def patrones_de(libro, u):
    """D2 sobre el libro de la sesión. Devuelve {nombre_patron: detalle}."""
    out = {}
    firmas = collections.Counter(e.get("firma") for e in libro if e.get("firma"))
    for f, n in firmas.items():
        if n >= u["firma_repetida"]:
            out["firma-repetida"] = _("el mismo error {n} veces (firma {f})", n=n, f=f)
            break
    rojos = collections.Counter(e.get("prog") for e in libro if e.get("cmd_es_check") and e.get("codigo") not in (None, 0))
    for p, n in rojos.items():
        if n >= u["check_en_rojo"]:
            out["check-en-rojo"] = _("`{p}` en rojo {n} veces", p=p, n=n)
            break
    ediciones = collections.Counter()
    for e in libro:
        if e.get("cmd_es_check") and e.get("codigo") == 0:
            ediciones.clear()
        root = e.get("repo") or ""
        for f in e.get("ficheros") or []:
            dentro = root and os.path.realpath(f).startswith(root.rstrip(os.sep) + os.sep)
            if dentro and not f.lower().endswith(SIN_CHECK):
                ediciones[f] += 1
    for f, n in ediciones.items():
        if n >= u["ediciones_sin_verde"]:
            out["ediciones-sin-verde"] = _("`{f}` editado {n} veces sin un check en verde entre medias", f=f, n=n)
            break
    ambiguos = collections.Counter(e.get("prog") for e in libro
                                   if e.get("cmd_sha") and e.get("codigo") == 0 and (e.get("stdout_vacio") or e.get("stderr_lineas", 0) > 0)
                                   and (e.get("cmd_es_check") or e.get("prog") in BUSCADORES))
    for p, n in ambiguos.items():
        if n >= u["verde_ambiguo"]:
            out["verde-ambiguo"] = _("`{p}` salió con 0 pero sin salida o con stderr {n} veces: un limpio que no se distingue de «no miré»", p=p, n=n)
            break
    return out


def cmd_observe(agente, args):
    """PostToolUse. Nunca bloquea; a lo sumo devuelve additionalContext. Fail-silent hacia
    state/observe.err para no romper la sesión."""
    try:
        ent = json.load(sys.stdin)
        if not isinstance(ent, dict):
            return 0
        sid = re.sub(r"[^A-Za-z0-9._-]", "_", str(ent.get("session_id") or "nosession"))
        cwd = ent.get("cwd") or os.getcwd()
        root = raiz_repo(cwd)
        ev = evento_desde_hook(ent)
        ev["repo"] = root
        if os.environ.get("ROMPELO_DEBUG_FORMA"):
            # Solo la FORMA del payload (tipo y claves), nunca texto: sirve para verificar qué manda cada
            # agente en un comando que falla (NO VERIFICADO en Codex, docs/observacion.md §12.2).
            resp = ent.get("tool_response")
            forma = {"t": ahora(), "agente": agente, "evento": ev["evento"], "tool": ev["tool"], "codigo": ev["codigo"],
                     "tool_use_id": str(ent.get("tool_use_id") or "")[:20], "transcript": bool(ent.get("transcript_path")),
                     "tipo": type(resp).__name__, "claves": sorted(resp.keys())[:20] if isinstance(resp, dict) else None,
                     "claves_error": sorted(k for k in ent.keys() if k not in ("tool_input", "tool_response")),
                     "primera_linea_exit": bool(re.match(r"\s*(?:Error:\s*)?Exit code", (resp if isinstance(resp, str) else "").split("\n", 1)[0]))}
            if isinstance(resp, dict):
                forma["subclaves"] = {k: sorted(v.keys())[:10] for k, v in resp.items() if isinstance(v, dict)}
                forma["tipos"] = {k: type(v).__name__ for k, v in resp.items()}
            elif isinstance(resp, str):
                forma["cabeza"] = resp[:120]  # solo bajo la variable de depuración, puesta a mano por el operador
            os.makedirs(ESTADO, exist_ok=True)
            with open(os.path.join(ESTADO, "forma.jsonl"), "a") as fh:
                fh.write(json.dumps(forma, ensure_ascii=False) + "\n")
        os.makedirs(os.path.join(ESTADO, "sesiones"), exist_ok=True)
        libro_f = os.path.join(ESTADO, "sesiones", f"{agente}-{sid}.jsonl")
        libro = []
        try:
            with open(libro_f) as fh:
                libro = [json.loads(l) for l in fh if l.strip()]
        except FileNotFoundError:
            pass
        perfiles = perfiles_de(ev)
        guardado = {k: v for k, v in ev.items() if k != "riesgo_texto"}
        guardado["perfiles"] = sorted(perfiles)
        with open(libro_f, "a") as fh:
            fh.write(json.dumps(guardado, ensure_ascii=False) + "\n")
        libro.append(guardado)
        if not root or root not in repos_permitidos():
            return 0  # se observa, pero solo se escala en repos alistados
        u = umbrales()
        est = estado_repo(root)
        est.setdefault("perfiles", [])
        est.setdefault("patrones", [])
        est.setdefault("avisos", {})
        nuevos = []
        libro_repo = [e for e in libro if e.get("repo") == root]
        toques = collections.Counter(p for e in libro_repo for p in (e.get("perfiles") or []))
        for p in sorted(perfiles):
            if p not in est["perfiles"] and toques[p] >= toques_perfil(p):
                est["perfiles"].append(p)
                nuevos.append(("perfil", p, _("la tarea toca `{p}` ({n} veces)", p=p, n=toques[p])))
        for nombre, detalle in patrones_de(libro_repo, u).items():
            if nombre not in est["patrones"]:
                est["patrones"].append(nombre)
                nuevos.append(("patron", nombre, detalle))
        if not nuevos:
            guardar_estado_repo(root, est)
            return 0
        est["nivel"] = max(int(est.get("nivel", 0) or 0), 2)
        clave = f"{agente}-{sid}"
        est["avisos"].setdefault(clave, [])
        pendientes = [n for n in nuevos if n[1] not in est["avisos"][clave]]
        est["avisos"][clave] += [n[1] for n in pendientes]
        est["fecha"] = ahora()
        guardar_estado_repo(root, est)
        if not pendientes:
            return 0
        exige = []
        if "junta" in est["perfiles"]:
            exige.append(_("cruce real de la junta después del último cambio (`rompelo cruce`)"))
        if "exterior" in est["perfiles"]:
            exige.append(_("cada afirmación sobre la dependencia o servicio con estado y fuente (`afirmaciones` en el contrato)"))
        if {"secretos", "datos", "auth", "despliegue"} & set(est["perfiles"]):
            exige.append(_("checks con control positivo cuando estén disponibles; hasta entonces, `min_lineas` en el registro"))
        exige.append(_("una segunda pasada explícita antes de cerrar (campo `segunda_pasada` del contrato)"))
        texto = _("[rompelo · observación] He reconocido {que}. Subo el rigor de este repo a nivel 2. Antes de seguir, dile al usuario en dos líneas qué patrón he visto y que a partir de ahora la tarea exige: {exige}.",
                  que="; ".join(d for _x, _y, d in pendientes), exige="; ".join(exige))
        try:
            n3 = leer_contrato(root).get("checks_nivel3") or []
        except Exception:
            n3 = []
        if n3:
            texto += _(" Para nivel 3 hay checks registrados en el contrato ({lista}): se exigen solo con permiso.", lista=", ".join(n3))
        texto += _(" Para búsquedas en internet o herramientas externas (nivel 3) pide permiso y regístralo con `rompelo permiso <patron> si|no [--recordar]`.")
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": texto}}, ensure_ascii=False))
        return 0
    except Exception as exc:
        try:
            os.makedirs(ESTADO, exist_ok=True)
            with open(os.path.join(ESTADO, "observe.err"), "a") as fh:
                fh.write(f"{ahora()} {exc.__class__.__name__}: {exc}\n")
        except Exception:
            pass
        return 0


def cmd_permiso(root, args):
    if len(args) < 2 or args[1] not in ("si", "sí", "no"):
        sys.exit("uso: rompelo permiso <patron> si|no [--recordar]")
    d = leer_json_o(PERMISOS, {})
    entrada = {"respuesta": "si" if args[1] in ("si", "sí") else "no", "fecha": ahora(), "repo": root, "recordar": "--recordar" in args}
    d.setdefault(args[0], []).append(entrada)
    os.makedirs(os.path.dirname(PERMISOS), exist_ok=True)
    with open(PERMISOS, "w") as fh:
        json.dump(d, fh, indent=2, ensure_ascii=False)
    est = estado_repo(root)
    if entrada["respuesta"] == "si":
        est["nivel"] = 3
        est.setdefault("permisos", []).append(args[0])
        guardar_estado_repo(root, est)
    print(f"permiso {entrada['respuesta']} para `{args[0]}`" + (" (recordado)" if entrada["recordar"] else "") + f" · nivel del repo: {est.get('nivel', 0)}")
    return 0


def cmd_nivel(root, args):
    est = estado_repo(root)
    if args and args[0] == "bajar":
        motivo = valor(args, "--motivo")
        if not motivo:
            sys.exit("uso: rompelo nivel bajar --motivo 'por qué'")
        est.update({"nivel": 0, "perfiles": [], "patrones": [], "bajado": {"fecha": ahora(), "motivo": motivo}})
        guardar_estado_repo(root, est)
    print(f"nivel {est.get('nivel', 0)} · perfiles {est.get('perfiles', [])} · patrones {est.get('patrones', [])}")
    return 0


def cmd_repos(args):
    for p in repos_permitidos():
        print(p)
    return 0


def cmd_hook(agente, args):
    """Stop hook. Mismo contrato en Claude Code y Codex (docs oficiales leídas 04-09-2026):
    stdin {session_id, cwd, stop_hook_active}; stdout {"decision":"block","reason":…} o nada."""
    try:
        ent = json.load(sys.stdin)
    except Exception:
        ent = {}
    cwd = ent.get("cwd") or os.getcwd()
    sid = re.sub(r"[^A-Za-z0-9._-]", "_", str(ent.get("session_id") or "nosession"))
    root = raiz_repo(cwd)
    if not root or root not in repos_permitidos():
        return 0  # fuera de la allowlist: silencio, y no se ejecuta nada
    tid = "sin-id"
    try:
        try:
            tid = re.sub(r"[^A-Za-z0-9._-]", "_", str(leer_contrato(root)["id"]))
        except Exception:
            pass
        m = motivos_bloqueo(root)
    except Exception as exc:  # contrato ilegible o fallo propio: fail-closed
        m = [_("rompelo no pudo evaluar el contrato ({exc}). Un repo alistado sin contrato legible no puede cerrar.", exc=f"{exc.__class__.__name__}: {exc}")]
    if not m:
        return 0
    # La marca del tope vive en el estado de rompelo, no en el tempdir: bajo el sandbox de Codex el
    # tempdir del hook no era escribible y el tope de 3 nunca llegaba (medido con codex exec, 05-09).
    os.makedirs(os.path.join(ESTADO, "marcas"), exist_ok=True)
    marca = os.path.join(ESTADO, "marcas", f"stop-{agente}-{sid}-{tid}")
    n = 0
    try:
        # una marca de hace más de un día es de otra jornada: se reinicia (las marcas ya no viven en tempdir)
        if (datetime.datetime.now().timestamp() - os.path.getmtime(marca)) < 86400:
            n = int(open(marca).read().strip() or 0)
    except Exception:
        pass
    n += 1
    try:
        open(marca, "w").write(str(n))
    except Exception:
        pass
    if n > TOPE_BLOQUEOS:
        print(json.dumps({"systemMessage": _("[rompelo] tope de {tope} bloqueos alcanzado: la tarea {tid} queda SIN VERIFICAR. ", tope=TOPE_BLOQUEOS, tid=tid) + " | ".join(m)}, ensure_ascii=False))
        return 0
    texto = _("[rompelo] La tarea {tid} NO puede darse por terminada ({n}/{tope}):\n", tid=tid, n=n, tope=TOPE_BLOQUEOS) + "\n".join("- " + x for x in m)
    print(json.dumps({"decision": "block", "reason": texto + _("\nNo declares la tarea terminada. Resuelve cada punto (rompelo check / rompelo cruce / disposición del hallazgo) y vuelve a intentarlo. Si algo no se puede cumplir, dilo como NO VERIFICADO y déjalo escrito en el contrato.")}, ensure_ascii=False))
    return 0


AYUDA = __doc__ + f"""
uso:
  rompelo init [--id ID] [--desc TXT] [--scope GLOB]... [--check ID]... [--junta] [--prueba] [--force] [--sin-detectar]
      sin --check, detecta los checks del repo (package.json, pyproject, Cargo.toml, go.mod, Makefile) y los registra en registry.local.json
  rompelo status | verify [--json] [--ci [--estricto]] | close | repos
  rompelo check [--id ID]...     sin --id ejecuta todos los checks del contrato; con --id solo esos (para iterar);
                                 cualquier otro argumento es error. Una suite entera puede pasar de 120 s, el
                                 timeout por defecto de la herramienta Bash de Claude Code: lánzala con timeout
                                 ≥ 300000 o en segundo plano, o el agente creerá que falló
  rompelo cruce [--nota TXT] (--id ID | -- <argv>)
  rompelo hook claude|codex      (lo llama el hook Stop; JSON por stdin)
  rompelo observe claude|codex   (lo llaman los hooks PostToolUse y PostToolUseFailure; JSON por stdin; nunca bloquea)
  rompelo nivel [bajar --motivo TXT] | permiso <patron> si|no [--recordar]
contrato: `checks_nivel3` lista checks que solo se exigen a nivel 3 (tras `rompelo permiso … si`)
idioma de los mensajes: ROMPELO_LANG=en, o "idioma": "en" en config/observacion.json
registro de checks: {REGISTRO}   allowlist: {ALLOWLIST}
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(AYUDA)
        return 0
    sub, args = argv[0], argv[1:]
    if sub == "hook":
        return cmd_hook(args[0] if args else "claude", args[1:])
    if sub == "observe":
        return cmd_observe(args[0] if args else "claude", args[1:])
    if sub == "repos":
        return cmd_repos(args)
    root = raiz_repo(os.getcwd())
    if not root:
        sys.exit("rompelo: no estás dentro de un repositorio git")
    tabla = {"init": cmd_init, "status": cmd_status, "verify": cmd_verify, "check": cmd_check,
             "cruce": cmd_cruce, "close": cmd_close, "permiso": cmd_permiso, "nivel": cmd_nivel}
    if sub not in tabla:
        sys.exit(f"rompelo: subcomando desconocido '{sub}'\n{AYUDA}")
    try:
        return tabla[sub](root, args) or 0
    except (FileNotFoundError, ValueError) as exc:
        sys.exit(f"rompelo: {exc}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
