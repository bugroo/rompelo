#!/usr/bin/env python3
"""rompelo — puerta de cierre por tarea, agnóstica del agente. Solo biblioteca estándar.

Un repo se alista con `rompelo init` (crea `.rompelo/task.json` y apunta el repo en la
allowlist `~/rompelo/config/repos.json`). Desde entonces el hook Stop de Claude Code o
de Codex llama a `rompelo hook <agente>` y la tarea NO puede darse por terminada hasta:

  1. cada id de `checks` ejecutado con `rompelo check` sobre EL MISMO contenido del
     árbol que hay ahora (huella); los comandos viven en `~/rompelo/checks/registry.json`,
     nunca en el contrato, y se ejecutan como argv, sin shell;
  2. si `toca_junta`, un cruce real (`rompelo cruce -- <argv>` o `--id <registro>`)
     con código 0 y sobre la misma huella, o sea DESPUÉS del último cambio;
  3. ningún hallazgo de `hallazgos` sin `disposicion`;
  4. ningún fichero cambiado fuera de `scope_paths`;
  5. si `exige_prueba_en_diff`, algún fichero de prueba cambiado.

Decide código normal. El modelo pide; esto concede. Fail-closed: un repo alistado con
contrato ilegible bloquea. Repos fuera de la allowlist: silencio, y no se ejecuta nada.
Tope de 3 bloqueos por sesión y tarea.
"""
import datetime, fnmatch, hashlib, json, os, re, subprocess, sys, tempfile

TOPE_BLOQUEOS = 3
ROMPELO_HOME = os.environ.get("ROMPELO_HOME") or os.path.join(os.path.expanduser("~"), "rompelo")
REGISTRO = os.path.join(ROMPELO_HOME, "checks", "registry.json")
REGISTRO_LOCAL = os.path.join(ROMPELO_HOME, "checks", "registry.local.json")
ALLOWLIST = os.path.join(ROMPELO_HOME, "config", "repos.json")
PRUEBAS_POR_DEFECTO = ["tests/**", "test/**", "**/*.test.*", "**/*.spec.*", "**/*_test.*"]
ID_OK = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
EXCL = [".", ":(exclude).rompelo"]


# ── git ─────────────────────────────────────────────────────────────────────
def git(root, *args):
    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)


def raiz_repo(cwd):
    r = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return os.path.realpath(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def head(root):
    r = git(root, "rev-parse", "HEAD")
    return r.stdout.strip() if r.returncode == 0 else "sin-head"


def ref_base(root, base):
    if base and git(root, "cat-file", "-e", f"{base}^{{commit}}").returncode == 0:
        return str(base)
    return "HEAD"


def huella_arbol(root, base=None):
    """Huella del CONTENIDO del árbol sin `.rompelo/`: para cada ruta que difiere de la base
    (rastreada o no), su hash de contenido, o D si se borró. No depende de HEAD ni de si el
    fichero está en el índice: commitear el mismo contenido no cambia la huella."""
    h = hashlib.sha256()
    for p in ficheros_cambiados(root, base):
        f = os.path.join(root, p)
        if os.path.isfile(f):
            h.update(f"{p}:{git(root, 'hash-object', '--', p).stdout.strip()}\n".encode())
        else:
            h.update(f"{p}:D\n".encode())
    return h.hexdigest()[:16]


def ficheros_cambiados(root, base):
    out = set()
    if head(root) != "sin-head":
        out |= {p for p in git(root, "diff", "--name-only", ref_base(root, base), "--", *EXCL).stdout.split("\n") if p}
    out |= {p for p in git(root, "ls-files", "--others", "--exclude-standard", "--", *EXCL).stdout.split("\n") if p}
    return sorted(out)


# ── configuración de confianza (fuera del repo) ─────────────────────────────
def leer_json(f):
    with open(f) as fh:
        return json.load(fh)


def registro(root=None):
    """registry.json (versionado, checks genéricos) + registry.local.json (sin versionar,
    checks de tus repos). Los locales ganan si repiten un id. Si ROMPELO_HOME no tiene ningún
    registro (un runner de CI), vale `.rompelo/registry.json` del propio repo: ahí el repo es la
    fuente de confianza, porque sus cambios pasan por revisión."""
    fuentes = [REGISTRO, REGISTRO_LOCAL]
    if root and not any(os.path.exists(f) for f in fuentes):
        fuentes = [os.path.join(root, ".rompelo", "registry.json")]
    r = {}
    for f in fuentes:
        try:
            parte = leer_json(f)
        except FileNotFoundError:
            continue
        if not isinstance(parte, dict):
            raise ValueError(f"{f} tiene que ser un objeto id → {{argv, cwd}}")
        r.update(parte)
    return {k: v for k, v in r.items() if not k.startswith("_")}


def repos_permitidos():
    try:
        d = leer_json(ALLOWLIST)
        return [os.path.realpath(p) for p in d.get("repos", [])]
    except FileNotFoundError:
        return []


def permitir_repo(root):
    os.makedirs(os.path.dirname(ALLOWLIST), exist_ok=True)
    d = {"repos": []}
    try:
        d = leer_json(ALLOWLIST)
    except FileNotFoundError:
        pass
    if root not in d.setdefault("repos", []):
        d["repos"].append(root)
        with open(ALLOWLIST, "w") as fh:
            json.dump(d, fh, indent=2, ensure_ascii=False)
            fh.write("\n")


def resolver_check(cid, root):
    """Devuelve (argv, cwd) de un id del registro. Nunca ejecuta texto del contrato."""
    if not isinstance(cid, str) or not ID_OK.match(cid):
        raise ValueError(f"id de check inválido (no se ejecuta): {cid!r}")
    reg = registro(root)
    if cid not in reg:
        raise ValueError(f"check desconocido, no está en {REGISTRO} (no se ejecuta): {cid}")
    e = reg[cid]
    argv = e.get("argv")
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        raise ValueError(f"registro: {cid}.argv tiene que ser una lista de cadenas")
    cwd = root if e.get("cwd", "repo") == "repo" else ROMPELO_HOME
    return argv, cwd


# ── contrato ────────────────────────────────────────────────────────────────
OBLIGATORIAS = ["id", "estado", "scope_paths", "checks", "toca_junta"]


def rutas(root):
    d = os.path.join(root, ".rompelo")
    return d, os.path.join(d, "task.json")


def ruta_limpia(p):
    return isinstance(p, str) and p and not p.startswith("/") and ".." not in p.split("/") and "\x00" not in p


def leer_contrato(root):
    _, f = rutas(root)
    c = leer_json(f)
    if not isinstance(c, dict):
        raise ValueError("task.json tiene que ser un objeto")
    faltan = [k for k in OBLIGATORIAS if k not in c]
    if faltan:
        raise ValueError(f"task.json sin claves obligatorias: {faltan}")
    if not isinstance(c["scope_paths"], list) or not all(ruta_limpia(p) for p in c["scope_paths"]):
        raise ValueError("scope_paths: lista de rutas relativas, sin '..' ni absolutas")
    if not isinstance(c["checks"], list) or not all(isinstance(x, str) and ID_OK.match(x) for x in c["checks"]):
        raise ValueError("checks: lista de ids [a-z0-9._-] del registro; los comandos no van en el contrato")
    if not isinstance(c["toca_junta"], bool):
        raise ValueError("toca_junta tiene que ser true/false")
    if not isinstance(c.get("hallazgos", []), list):
        raise ValueError("hallazgos tiene que ser una lista")
    return c


def dir_evidencia(root, c):
    base = os.path.join(root, ".rompelo", "evidence")
    d = os.path.join(base, re.sub(r"[^A-Za-z0-9._-]", "_", str(c["id"])))
    os.makedirs(d, exist_ok=True)
    gi = os.path.join(base, ".gitignore")  # la evidencia se autoignora; el .gitignore del repo no se toca
    if not os.path.exists(gi):
        with open(gi, "w") as fh:
            fh.write("*\n")
    return d


def leer_evidencia(d, nombre):
    try:
        return leer_json(os.path.join(d, nombre))
    except (FileNotFoundError, ValueError):
        return None


def escribir_evidencia(d, nombre, datos):
    with open(os.path.join(d, nombre), "w") as fh:
        json.dump(datos, fh, indent=2, ensure_ascii=False)
        fh.write("\n")


def ahora():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def casa(path, patron):
    patron = patron.rstrip("/")
    if any(ch in patron for ch in "*?["):
        return fnmatch.fnmatch(path, patron) or fnmatch.fnmatch(path, patron.replace("**/", ""))
    return path == patron or path.startswith(patron + "/")


# ── veredicto ───────────────────────────────────────────────────────────────
def motivos_bloqueo(root, para_cerrar=False, ci=None):
    """ci: {"evidencias": {id: evidencia recién producida}, "estricto": bool, "advertencias": []}.
    En CI no se cree ninguna evidencia guardada (la pudo escribir el agente): los checks se
    ejecutan de nuevo allí. El cruce real no se puede reproducir en CI: queda como advertencia,
    o como bloqueo con --estricto."""
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    hu = huella_arbol(root, c.get("base"))
    m = []

    if str(c["estado"]) == "cerrada" and not ci:
        cerr = leer_evidencia(ev, "cerrada.json")
        if cerr and cerr.get("huella") == hu:
            return []
        if not para_cerrar:
            m.append("estado: cerrada, pero hay cambios posteriores al cierre (huella distinta). Vuelve a `rompelo check` y `rompelo close`.")

    cambiados = ficheros_cambiados(root, c.get("base"))
    fuera = [p for p in cambiados if not any(casa(p, s) for s in c["scope_paths"])]
    if fuera:
        m.append("fuera de scope_paths: " + ", ".join(fuera[:8]) + (" …" if len(fuera) > 8 else ""))

    reg = registro(root)
    for cid in c["checks"]:
        if cid not in reg:
            m.append(f"check `{cid}` no está en el registro ({REGISTRO}); no se ejecuta ni cuenta")
            continue
        e = ci["evidencias"].get(cid) if ci else leer_evidencia(ev, f"check-{cid}.json")
        if e is None:
            m.append(f"check `{cid}` sin ejecutar (usa `rompelo check`)")
        elif e.get("argv") != reg[cid].get("argv"):
            m.append(f"check `{cid}` cambió en el registro después de ejecutarse")
        elif e.get("codigo") != 0:
            m.append(f"check `{cid}` FALLÓ con código {e.get('codigo')}")
        elif e.get("lineas_salida", 0) < int(reg[cid].get("min_lineas", 0) or 0):
            m.append(f"check `{cid}` salió con 0 pero sin la salida mínima ({e.get('lineas_salida')} < {reg[cid].get('min_lineas')} líneas): «limpio» no se distingue de «no miré»")
        elif e.get("huella") != hu:
            m.append(f"check `{cid}` se ejecutó sobre otro árbol (hay cambios posteriores)")

    if c["toca_junta"] and ci:
        txt = "toca_junta: true. El cruce real no se puede reproducir en CI; hay que hacerlo fuera y quedar registrado con `rompelo cruce`."
        (m if ci.get("estricto") else ci["advertencias"]).append(txt)
    elif c["toca_junta"]:
        cr = leer_evidencia(ev, "cruce.json")
        if cr is None:
            m.append("toca_junta: true y no hay cruce real registrado (`rompelo cruce --nota '…' -- <comando real>`)")
        elif cr.get("codigo") != 0:
            m.append(f"el cruce real FALLÓ con código {cr.get('codigo')}: {cr.get('argv')}")
        elif cr.get("huella") != hu:
            m.append("el cruce real es anterior al último cambio; hay que cruzar DESPUÉS de desplegar el último cambio")

    for h in c.get("hallazgos") or []:
        if not isinstance(h, dict) or not str(h.get("disposicion") or "").strip():
            m.append(f"hallazgo sin disposición: {h.get('id') if isinstance(h, dict) else h}")

    # Afirmaciones materiales sobre el mundo exterior (criterio de rootml-de, 04-09-2026):
    # cada una lleva estado. verificado = fuente de primera mano + cita textual que zanja;
    # derivado = de qué afirmación verificada; no_verificado = qué falta. Sin estado no existe.
    afs = c.get("afirmaciones") or []
    if c.get("toca_exterior") and not afs:
        m.append("toca_exterior: true y no hay ninguna afirmación con estado (verificado | derivado | no_verificado)")
    for i, a in enumerate(afs, 1):
        et = a.get("estado") if isinstance(a, dict) else None
        tx = (a.get("texto") if isinstance(a, dict) else str(a)) or f"#{i}"
        if et == "verificado":
            if not (str(a.get("fuente") or "").strip() and str(a.get("cita") or "").strip()):
                m.append(f"afirmación «{tx}» marcada verificado sin fuente de primera mano o sin cita textual")
        elif et == "derivado":
            if not str(a.get("de") or "").strip():
                m.append(f"afirmación «{tx}» marcada derivado sin decir de qué se deduce")
        elif et == "no_verificado":
            if not str(a.get("falta") or "").strip():
                m.append(f"afirmación «{tx}» marcada no_verificado sin decir qué falta")
        else:
            m.append(f"afirmación «{tx}» sin estado válido (verificado | derivado | no_verificado)")

    if c.get("exige_prueba_en_diff"):
        globs = c.get("pruebas_glob") or PRUEBAS_POR_DEFECTO
        prueba = [p for p in cambiados if any(casa(p, g) for g in globs)]
        if [p for p in cambiados if p not in prueba] and not prueba:
            m.append("el diff cambia código y ninguna prueba (exige_prueba_en_diff). Verde no es cubierto.")
    return m


# ── ejecución sin shell ─────────────────────────────────────────────────────
def ejecutar(argv, cwd):
    t0 = datetime.datetime.now()
    try:
        r = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
        codigo, salida = r.returncode, (r.stdout or "") + (r.stderr or "")
    except OSError as exc:
        codigo, salida = 127, str(exc)
    dur = (datetime.datetime.now() - t0).total_seconds()
    # No se guarda la salida (podría llevar secretos): solo tamaño y hash.
    return {"argv": argv, "cwd": cwd, "codigo": codigo, "segundos": round(dur, 1),
            "lineas_salida": salida.count("\n"),
            "sha_salida": hashlib.sha256(salida.encode()).hexdigest()[:12], "fecha": ahora()}, salida


# ── subcomandos ─────────────────────────────────────────────────────────────
def valor(args, k):
    return args[args.index(k) + 1] if k in args and args.index(k) + 1 < len(args) else None


def valores(args, k):
    return [args[i + 1] for i, a in enumerate(args) if a == k and i + 1 < len(args)]


def cmd_init(root, args):
    d, f = rutas(root)
    if os.path.exists(f) and "--force" not in args:
        sys.exit(f"ya existe {f} (usa --force para sobrescribir)")
    os.makedirs(d, exist_ok=True)
    checks = valores(args, "--check")
    reg = registro(root)
    desconocidos = [x for x in checks if x not in reg]
    if desconocidos:
        sys.exit(f"checks que no están en el registro {REGISTRO}: {desconocidos}. Añádelos ahí primero (argv, no cadena).")
    c = {
        "schema": 1,
        "id": valor(args, "--id") or "TAREA-" + datetime.date.today().isoformat(),
        "estado": "abierta",
        "base": head(root),
        "descripcion": valor(args, "--desc") or "",
        "scope_paths": valores(args, "--scope") or ["**"],
        "checks": checks,
        "toca_junta": "--junta" in args,
        "exige_prueba_en_diff": "--prueba" in args,
        "hallazgos": [],
        "_ayuda": "hallazgos: [{id, texto, disposicion: confirmado|rechazado|aceptado, nota}]. Lo concede código, no el modelo.",
    }
    with open(f, "w") as fh:
        json.dump(c, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    dir_evidencia(root, c)  # crea .rompelo/evidence/.gitignore
    permitir_repo(root)
    print(f"contrato creado: {f}\nrepo alistado en {ALLOWLIST}")


def cmd_check(root, args):
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    if not c["checks"]:
        print("el contrato no tiene checks")
        return 0
    fallos = 0
    for i, cid in enumerate(c["checks"], 1):
        argv, cwd = resolver_check(cid, root)
        print(f"[{i}/{len(c['checks'])}] {cid}: {' '.join(argv)}")
        e, salida = ejecutar(argv, cwd)
        e["id"] = cid
        e["huella"] = huella_arbol(root, c.get("base"))
        escribir_evidencia(ev, f"check-{cid}.json", e)
        if e["codigo"] != 0:
            fallos += 1
            print("".join(salida.splitlines(True)[-15:]), end="")
        print(f"    → código {e['codigo']} en {e['segundos']} s")
    print("todos en verde" if not fallos else f"{fallos} check(s) en rojo")
    return 1 if fallos else 0


def cmd_cruce(root, args):
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    if "--id" in args:
        argv, cwd = resolver_check(valor(args, "--id"), root)
    elif "--" in args and args[args.index("--") + 1:]:
        argv, cwd = args[args.index("--") + 1:], root
    else:
        sys.exit("uso: rompelo cruce [--nota TXT] (--id <check del registro> | -- <argv del comando real>)")
    e, salida = ejecutar(argv, cwd)
    e["nota"] = valor(args, "--nota") or ""
    e["huella"] = huella_arbol(root, c.get("base"))
    escribir_evidencia(ev, "cruce.json", e)
    print(("cruce OK" if e["codigo"] == 0 else f"cruce FALLÓ (código {e['codigo']})") + ": " + " ".join(argv))
    if e["codigo"] != 0:
        print("".join(salida.splitlines(True)[-15:]), end="")
    return 0 if e["codigo"] == 0 else 1


def cmd_verify(root, args):
    ci = None
    if "--ci" in args:
        c = leer_contrato(root)
        ci = {"evidencias": {}, "estricto": "--estricto" in args, "advertencias": []}
        hu = huella_arbol(root, c.get("base"))
        for cid in c["checks"]:
            try:
                argv, cwd = resolver_check(cid, root)
            except ValueError:
                continue  # lo reporta motivos_bloqueo como «no está en el registro»
            e, _ = ejecutar(argv, cwd)
            e["huella"] = hu
            ci["evidencias"][cid] = e
            if "--json" not in args:
                print(f"[ci] {cid}: código {e['codigo']} en {e['segundos']} s, {e['lineas_salida']} líneas")
    m = motivos_bloqueo(root, ci=ci)
    if ci and ci["advertencias"] and "--json" not in args:
        for a in ci["advertencias"]:
            print("ADVERTENCIA: " + a)
    if ci and "--json" in args:
        print(json.dumps({"ok": not m, "motivos": m, "advertencias": ci["advertencias"]}, ensure_ascii=False))
        return 0 if not m else 1
    if "--json" in args:
        print(json.dumps({"ok": not m, "motivos": m}, ensure_ascii=False))
    elif m:
        print("BLOQUEADO:")
        for x in m:
            print("  - " + x)
    else:
        print("OK: la tarea puede cerrarse")
    return 0 if not m else 1


def cmd_close(root, args):
    m = motivos_bloqueo(root, para_cerrar=True)
    if m:
        print("no se puede cerrar:")
        for x in m:
            print("  - " + x)
        return 1
    c = leer_contrato(root)
    ev = dir_evidencia(root, c)
    hu = huella_arbol(root, c.get("base"))
    escribir_evidencia(ev, "cerrada.json", {"huella": hu, "fecha": ahora()})
    _, f = rutas(root)
    c["estado"] = "cerrada"
    with open(f, "w") as fh:
        json.dump(c, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    print(f"tarea {c['id']} cerrada sobre la huella {hu}")
    return 0


def cmd_status(root, args):
    c = leer_contrato(root)
    print(f"tarea {c['id']} · estado {c['estado']} · huella {huella_arbol(root, c.get('base'))}")
    print(f"scope: {c['scope_paths']}  checks: {c['checks']}")
    print(f"cambiados: {ficheros_cambiados(root, c.get('base'))}")
    return cmd_verify(root, args)


def cmd_repos(args):
    for p in repos_permitidos():
        print(p)
    return 0


def cmd_hook(agente, args):
    """Stop hook. Mismo contrato en Claude Code y Codex (docs oficiales leídas 04-09-2026):
    stdin {session_id, cwd, stop_hook_active}; stdout {"decision":"block","reason":…} o nada."""
    try:
        ent = json.load(sys.stdin)
    except Exception:
        ent = {}
    cwd = ent.get("cwd") or os.getcwd()
    sid = re.sub(r"[^A-Za-z0-9._-]", "_", str(ent.get("session_id") or "nosession"))
    root = raiz_repo(cwd)
    if not root or root not in repos_permitidos():
        return 0  # fuera de la allowlist: silencio, y no se ejecuta nada
    tid = "sin-id"
    try:
        try:
            tid = re.sub(r"[^A-Za-z0-9._-]", "_", str(leer_contrato(root)["id"]))
        except Exception:
            pass
        m = motivos_bloqueo(root)
    except Exception as exc:  # contrato ilegible o fallo propio: fail-closed
        m = [f"rompelo no pudo evaluar el contrato ({exc.__class__.__name__}: {exc}). Un repo alistado sin contrato legible no puede cerrar."]
    if not m:
        return 0
    marca = os.path.join(tempfile.gettempdir(), f"rompelo-stop-{sid}-{tid}")
    n = 0
    try:
        n = int(open(marca).read().strip() or 0)
    except Exception:
        pass
    n += 1
    try:
        open(marca, "w").write(str(n))
    except Exception:
        pass
    if n > TOPE_BLOQUEOS:
        print(json.dumps({"systemMessage": f"[rompelo] tope de {TOPE_BLOQUEOS} bloqueos alcanzado: la tarea {tid} queda SIN VERIFICAR. " + " | ".join(m)}, ensure_ascii=False))
        return 0
    texto = f"[rompelo] La tarea {tid} NO puede darse por terminada ({n}/{TOPE_BLOQUEOS}):\n" + "\n".join("- " + x for x in m)
    print(json.dumps({"decision": "block", "reason": texto + "\nNo declares la tarea terminada. Resuelve cada punto (rompelo check / rompelo cruce / disposición del hallazgo) y vuelve a intentarlo. Si algo no se puede cumplir, dilo como NO VERIFICADO y déjalo escrito en el contrato."}, ensure_ascii=False))
    return 0


AYUDA = __doc__ + f"""
uso:
  rompelo init [--id ID] [--desc TXT] [--scope GLOB]... [--check ID]... [--junta] [--prueba] [--force]
  rompelo status | verify [--json] [--ci [--estricto]] | check | close | repos
  rompelo cruce [--nota TXT] (--id ID | -- <argv>)
  rompelo hook claude|codex      (lo llama el hook Stop; JSON por stdin)
registro de checks: {REGISTRO}   allowlist: {ALLOWLIST}
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(AYUDA)
        return 0
    sub, args = argv[0], argv[1:]
    if sub == "hook":
        return cmd_hook(args[0] if args else "claude", args[1:])
    if sub == "repos":
        return cmd_repos(args)
    root = raiz_repo(os.getcwd())
    if not root:
        sys.exit("rompelo: no estás dentro de un repositorio git")
    tabla = {"init": cmd_init, "status": cmd_status, "verify": cmd_verify, "check": cmd_check,
             "cruce": cmd_cruce, "close": cmd_close}
    if sub not in tabla:
        sys.exit(f"rompelo: subcomando desconocido '{sub}'\n{AYUDA}")
    try:
        return tabla[sub](root, args) or 0
    except (FileNotFoundError, ValueError) as exc:
        sys.exit(f"rompelo: {exc}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
