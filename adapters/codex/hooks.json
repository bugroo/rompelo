{
  "description": "rompelo · puerta de cierre por tarea. Mismo contrato que el hook Stop de Claude Code.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/rompelo/bin/rompelo\" hook codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/rompelo/bin/rompelo\" observe codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
